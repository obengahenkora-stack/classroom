# Copy this file to .env and fill in the values.

# From LiveKit Cloud (https://cloud.livekit.io) or your self-hosted server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Password teachers type to log in as host. Choose something long.
HOST_PASSWORD=change-me-to-something-long

# Random string used to sign teacher login cookies
SESSION_SECRET=change-me-too

PORT=3000

# Max students allowed in one class
MAX_PARTICIPANTS=550
